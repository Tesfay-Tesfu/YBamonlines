# Copy to .env for local development (the server reads .env automatically if present).
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amtutortools
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# First admin (created on first start only if no admin exists yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Optional email (verification + password reset) through an email API.
# Without a key, links are printed to the server log and admins can verify accounts by hand.
# RESEND_API_KEY=re_xxx            (resend.com)   or   BREVO_API_KEY=xkeysib-xxx   (brevo.com)
# MAIL_FROM="AMtutorTools <no-reply@yourdomain.com>"

# Set to 1 when the database needs SSL but has a self-signed cert (Render internal URLs don't)
# DATABASE_SSL=1
